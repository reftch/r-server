{
  "realm": "rserver",
  "enabled": true,
  "clients": [
    {
      "clientId": "rserver-app",
      "name": "R-Server Keycloak Example",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "rserver-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/auth/keycloak/callback"],
      "webOrigins": ["http://localhost:8080"],
      "attributes": {}
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ]
    }
  ]
}
